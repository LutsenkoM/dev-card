.idea/

# macOS
.DS_Store

# Ignore the whole WordPress install...
/wordpress/*
# ...but keep the path down to our theme
!/wordpress/wp-content/
/wordpress/wp-content/*
!/wordpress/wp-content/themes/
/wordpress/wp-content/themes/*
!/wordpress/wp-content/themes/dev-card/

# Personal documents (CV etc.) — never commit
*.pdf
*.docx
